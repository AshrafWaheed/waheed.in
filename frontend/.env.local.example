# Copy this file to .env.local and fill in your credentials.
# The site works without these — emails / Beehiiv just won't fire until they're set.

# Beehiiv newsletter API (used by /api/newsletter)
BEEHIIV_API_KEY=your-beehiiv-api-key
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Hostinger / private email SMTP (SSL on port 465)
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@waheed.in
SMTP_PASS=your-email-password-here

# "From" address shown in sent emails
SMTP_FROM="WAHEED <info@waheed.in>"

# Where alert emails land (new contact application / new newsletter subscriber)
ALERT_TO=info@waheed.in
